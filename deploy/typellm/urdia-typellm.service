[Unit]
Description=Urdia local TypeLLM decision bridge
After=network.target
ConditionPathExists=/etc/urdia/typellm.conf

[Service]
Type=simple
ExecStart=/opt/urdia/typellm/start.sh
Restart=on-failure
RestartSec=5s
TimeoutStartSec=2min
TimeoutStopSec=30s

DynamicUser=yes
LoadCredential=typellm_key:/etc/urdia/secrets/typellm.key
EnvironmentFile=/etc/urdia/typellm.conf
Environment=HF_HUB_OFFLINE=1
Environment=TRANSFORMERS_OFFLINE=1
Environment=TOKENIZERS_PARALLELISM=false
Environment=HTTP_PROXY=
Environment=HTTPS_PROXY=
Environment=ALL_PROXY=
Environment=NO_PROXY=127.0.0.1,::1

NoNewPrivileges=yes
CapabilityBoundingSet=
AmbientCapabilities=
PrivateDevices=yes
PrivateTmp=yes
ProtectSystem=strict
ProtectHome=yes
ProtectControlGroups=yes
ProtectKernelModules=yes
ProtectKernelTunables=yes
ProtectKernelLogs=yes
ProtectClock=yes
ProtectHostname=yes
ProtectProc=invisible
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
RemoveIPC=yes
UMask=0077
TasksMax=64
MemoryMax=8G
ReadOnlyPaths=/opt/urdia/typellm

IPAddressDeny=any
IPAddressAllow=localhost

[Install]
WantedBy=multi-user.target
