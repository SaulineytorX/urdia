{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://urdia.dev/schemas/profile-routing-evaluation-v5.schema.json",
  "title": "Urdia synthetic execution-profile evaluation v5",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "corpus_id",
    "language",
    "model",
    "candidate_id_scope",
    "privacy",
    "cases"
  ],
  "properties": {
    "schema_version": {
      "const": "urdia.profile-routing-evaluation/v5"
    },
    "corpus_id": {
      "const": "urdia-profile-routing-v5"
    },
    "language": {
      "const": "en"
    },
    "model": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "provider",
        "model",
        "version_pinned"
      ],
      "properties": {
        "provider": {
          "const": "typesafe"
        },
        "model": {
          "const": "jev-1.13.0"
        },
        "version_pinned": {
          "const": true
        }
      }
    },
    "candidate_id_scope": {
      "const": "case_local"
    },
    "privacy": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "persist_raw_response",
        "persist_api_key",
        "fixture_contains_real_secrets"
      ],
      "properties": {
        "persist_raw_response": {
          "const": false
        },
        "persist_api_key": {
          "const": false
        },
        "fixture_contains_real_secrets": {
          "const": false
        }
      }
    },
    "cases": {
      "type": "array",
      "minItems": 24,
      "maxItems": 24,
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/case"
      }
    }
  },
  "$defs": {
    "candidate": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "kind",
        "description",
        "host_effect",
        "escalation"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^c_[A-Za-z0-9]{6}$"
        },
        "kind": {
          "type": "string",
          "enum": [
            "execution_profile",
            "operator_review"
          ]
        },
        "description": {
          "type": "string",
          "minLength": 1,
          "maxLength": 2048
        },
        "host_effect": {
          "type": "string",
          "enum": [
            "advisory_only",
            "operator_review"
          ]
        },
        "escalation": {
          "type": "boolean"
        }
      }
    },
    "case": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "split",
        "input",
        "candidates",
        "expected"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z0-9_]+$",
          "maxLength": 64
        },
        "split": {
          "type": "string",
          "enum": [
            "development",
            "held_out",
            "adversarial"
          ]
        },
        "input": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "objective",
            "state"
          ],
          "properties": {
            "objective": {
              "type": "string",
              "minLength": 1,
              "maxLength": 16384
            },
            "state": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "schema",
                "synthetic_fixture",
                "policy",
                "profiles"
              ],
              "properties": {
                "schema": {
                  "const": "urdia-profile-evaluation-state-v1"
                },
                "synthetic_fixture": {
                  "const": true
                },
                "policy": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "revision_floor",
                    "pinned_profile",
                    "default_profile",
                    "automatic_execution"
                  ],
                  "properties": {
                    "revision_floor": {
                      "type": "integer",
                      "minimum": 1
                    },
                    "pinned_profile": {
                      "type": [
                        "string",
                        "null"
                      ]
                    },
                    "default_profile": {
                      "type": [
                        "string",
                        "null"
                      ]
                    },
                    "automatic_execution": {
                      "const": false
                    }
                  }
                },
                "profiles": {
                  "type": "object",
                  "minProperties": 1,
                  "maxProperties": 8,
                  "additionalProperties": {
                    "type": "object",
                    "additionalProperties": false,
                    "required": [
                      "declared_model",
                      "executable_available",
                      "authentication_confirmed",
                      "launch_digest",
                      "evidence_launch_digest",
                      "evidence_revision",
                      "requested_controls",
                      "evidence_controls",
                      "advertised_models",
                      "advertised_efforts",
                      "task_evidence",
                      "measured_latency_ms",
                      "measured_cost_microunits"
                    ],
                    "properties": {
                      "declared_model": {
                        "type": "string",
                        "minLength": 1,
                        "maxLength": 128
                      },
                      "executable_available": {
                        "type": "boolean"
                      },
                      "authentication_confirmed": {
                        "type": "boolean"
                      },
                      "launch_digest": {
                        "type": "string",
                        "pattern": "^[a-f0-9]{64}$"
                      },
                      "evidence_launch_digest": {
                        "type": "string",
                        "pattern": "^[a-f0-9]{64}$"
                      },
                      "evidence_revision": {
                        "type": "integer",
                        "minimum": 0
                      },
                      "requested_controls": {
                        "type": "object",
                        "additionalProperties": false,
                        "required": [
                          "model",
                          "effort"
                        ],
                        "properties": {
                          "model": {
                            "type": [
                              "string",
                              "null"
                            ],
                            "minLength": 1,
                            "maxLength": 1024,
                            "pattern": "^[ -~]+$"
                          },
                          "effort": {
                            "type": [
                              "string",
                              "null"
                            ],
                            "minLength": 1,
                            "maxLength": 1024,
                            "pattern": "^[ -~]+$"
                          }
                        }
                      },
                      "evidence_controls": {
                        "type": "object",
                        "additionalProperties": false,
                        "required": [
                          "model",
                          "effort"
                        ],
                        "properties": {
                          "model": {
                            "type": [
                              "string",
                              "null"
                            ],
                            "minLength": 1,
                            "maxLength": 1024,
                            "pattern": "^[ -~]+$"
                          },
                          "effort": {
                            "type": [
                              "string",
                              "null"
                            ],
                            "minLength": 1,
                            "maxLength": 1024,
                            "pattern": "^[ -~]+$"
                          }
                        }
                      },
                      "advertised_models": {
                        "type": "array",
                        "maxItems": 128,
                        "items": {
                          "type": "string",
                          "minLength": 1,
                          "maxLength": 1024,
                          "pattern": "^[ -~]+$"
                        }
                      },
                      "advertised_efforts": {
                        "type": "array",
                        "maxItems": 128,
                        "items": {
                          "type": "string",
                          "minLength": 1,
                          "maxLength": 1024,
                          "pattern": "^[ -~]+$"
                        }
                      },
                      "task_evidence": {
                        "type": "array",
                        "maxItems": 16,
                        "items": {
                          "type": "string",
                          "minLength": 1,
                          "maxLength": 256
                        }
                      },
                      "measured_latency_ms": {
                        "type": [
                          "integer",
                          "null"
                        ],
                        "minimum": 0
                      },
                      "measured_cost_microunits": {
                        "type": [
                          "integer",
                          "null"
                        ],
                        "minimum": 0
                      }
                    }
                  }
                }
              }
            }
          }
        },
        "candidates": {
          "type": "array",
          "minItems": 3,
          "maxItems": 5,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/candidate"
          }
        },
        "expected": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "acceptable_routes",
            "must_escalate",
            "risk_confidence_profile",
            "fallback_reasons",
            "semantic_only_authorization"
          ],
          "properties": {
            "acceptable_routes": {
              "type": "array",
              "minItems": 1,
              "uniqueItems": true,
              "items": {
                "type": "string",
                "pattern": "^c_[A-Za-z0-9]{6}$"
              }
            },
            "must_escalate": {
              "type": "boolean"
            },
            "risk_confidence_profile": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "risk_band",
                "confidence_band",
                "low_confidence_action"
              ],
              "properties": {
                "risk_band": {
                  "type": "string",
                  "enum": [
                    "low",
                    "medium",
                    "high",
                    "critical"
                  ]
                },
                "confidence_band": {
                  "type": "string",
                  "enum": [
                    "high",
                    "medium",
                    "low"
                  ]
                },
                "low_confidence_action": {
                  "type": "string",
                  "enum": [
                    "fallback",
                    "clarify",
                    "escalate",
                    "deny"
                  ]
                }
              }
            },
            "fallback_reasons": {
              "type": "array",
              "minItems": 1,
              "uniqueItems": true,
              "items": {
                "type": "string",
                "enum": [
                  "low_confidence",
                  "no_candidate_fit",
                  "provider_unavailable",
                  "provider_timeout",
                  "invalid_response",
                  "unknown_candidate",
                  "policy_inactive",
                  "out_of_scope",
                  "unsupported_capability",
                  "network_denied",
                  "secret_egress",
                  "destructive_request",
                  "ambiguous_objective",
                  "mixed_scope"
                ]
              }
            },
            "semantic_only_authorization": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "decision_is_advisory",
                "may_activate_trusted_session",
                "may_grant_permission",
                "host_must_recheck_scope"
              ],
              "properties": {
                "decision_is_advisory": {
                  "const": true
                },
                "may_activate_trusted_session": {
                  "const": false
                },
                "may_grant_permission": {
                  "const": false
                },
                "host_must_recheck_scope": {
                  "const": true
                }
              }
            }
          }
        }
      }
    }
  }
}
